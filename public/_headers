# Cache policy for Cloudflare Workers Assets.
#
# The default for every file is `public, max-age=0, must-revalidate`, which is
# right for the HTML and wrong for everything whose URL already identifies its
# contents. Left alone, a returning visitor pays a conditional request for each
# of the twenty chunks and every image before reusing any of them.
#
# Rules are applied in order, so the narrower ones come last.

# --- Security headers -------------------------------------------------------
# Applied to everything. These are header names the cache rules below do not
# set, so the two sets do not collide.
#
# About the CSP: script-src has to carry 'unsafe-inline'. This is a static
# export with no server, so there is no nonce to issue, and the output has six
# inline scripts — Next's own hydration bootstrap plus the theme script that
# runs before first paint. That means this CSP does NOT stop cross-site
# scripting. What it still does is bound where things may come from: no script
# from another origin, no framing, no plugins, no form posting elsewhere, no
# base-tag rewrite, and images and media only from the hosts this site really
# uses. style-src needs 'unsafe-inline' too — the design is built from inline
# style attributes, 278 of them on the home page alone.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://static.wixstatic.com https://i.ytimg.com https://play.google.com; media-src 'self' https://video.wixstatic.com; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin


# Anything not named below: a day in the browser, then a week where a stale
# copy may be served while a fresh one is fetched. This covers the artwork in
# /assets, which is NOT content-hashed — hc-theme-the-lord-reigns.webp is the
# October 2026 theme and will be replaced in place when the edition changes, so
# a year of immutable would leave returning visitors on last season's art.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Next.js puts a content hash in these filenames precisely so they can be kept
# forever: if the contents change, the URL changes. immutable also tells the
# browser not to revalidate on reload.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The webfonts are fixed binaries cut from a fixed subset. If one is ever
# swapped, give the new file a new name rather than shortening this.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
